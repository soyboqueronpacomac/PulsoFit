---
import styles from '@styles/organisms/home-plans/grids/PlansGrid.module.css'
---

<section class={styles.plansGrid}>
  <article class={styles.card}>
    <h4>Básico</h4>
    <h5 class={styles.prices}>24,90€<span>/mes</span></h5> 
    <p>Tu club, a  tu ritmo.</p>
    <ul>
      <li>Acceso a 1 Club</li>
      <li>Musculación y Cardio</li>
      <li>App con rutinas guiadas</li>
      <li>Sin matricula</li>
    </ul>
    <button>Elegir Básico</button>
  </article>
  <article class={styles.cardActive}>
    <h4>Premium <span>Mas Popular</span></h4>
    <h5 class={styles.prices}>39,90€<span>/mes</span></h5>
   <p>El favorito de nuestros socios.</p>
    <ul>
      <li>Acceso a todos los clubes</li>
      <li>Clases dirigidas ilimitadas</li>
      <li>1 sesión con entrenador/mes</li>
      <li>Trae un amigo 2 veces/mes </li>
    </ul>
    <button>Elegir Premium</button>
  </article>
  <article class={styles.card}>
    <h4>Elite</h4>
    <h5 class={styles.prices}>59,90€<span>/mes</span></h5>
    <p>Rendimiento sin compromisos.</p>
    <ul>
      <li>Todo lo de Premium</li>
      <li>4 sesiones de entrenador personal</li>
      <li>Spa y zona wellness</li>
      <li>Plan nutricional personalizado</li>
    </ul>
    <button>Elegir Elite</button>
  </article>
</section>


