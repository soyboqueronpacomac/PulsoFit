---
import styles from "@styles/organisms/hero/HeroInfo.module.css";
---

<section class={styles.heroInfo}>
  <span>
    <span class={styles.circle}></span>
    <small>+120 clubes en toda España</small>
  </span>
  <h2>
    Entrena <span>sin límites. </span>En cualquier club.
  </h2>
  <p>
    Una sola couta, más de 120 clubes en 48 ciudades. Clases dirigidas,
    entrenadores certificados y abierto 24/7. Sin matrícula, sin permanecia.
  </p>
  <div class={styles.buttons}>
    <button class={styles.primary}>Ver planes desde 24,90€</button>
    <button class={styles.secondary}>Encuentra tu club</button>
  </div>
  <section class={styles.infos}>
    <div>
      <h4>120+</h4>
      <p>Clubes</p>
    </div>
    <div>
      <h4>48</h4>
      <p>Ciudades</p>
    </div>
    <div>
      <h4>350K</h4>
      <p>Socios</p>
    </div>
    <div>
      <h4>24/7</h4>
      <p>Abierto</p>
    </div>
  </section>
</section>
